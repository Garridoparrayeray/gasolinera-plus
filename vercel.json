{
  "regions": [
    "cdg1"
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{data/stations-lite.json,data/road-graph/**,data/places.json,tests/**,tools/**,scripts/**,screenshots/**,icons/**,vendor/**,js/**,*.css,*.md,node_modules/**,android/**,ios/**,www/**}"
    }
  },
  "redirects": [
    {
      "source": "/data/gasolinera.sqlite",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/scripts/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tests/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tools/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/dev-router.php",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.php"
    },
    {
      "source": "/stations/(.*)",
      "destination": "/api/shell.php"
    },
    {
      "source": "/",
      "destination": "/api/shell.php"
    }
  ]
}
